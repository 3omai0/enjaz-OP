# ------------------------------------------------------------------
# Injaz environment
# ------------------------------------------------------------------

# Neon Postgres connection string (Neon dashboard > Connect > copy the
# pooled connection string). Leave it EMPTY to run in local mode: the app
# then uses an embedded Postgres (PGlite) stored in ./.data/pglite.
DATABASE_URL=

# Required, at least 32 characters. Signs login sessions; the app refuses to
# start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Device notifications (Web Push) for phones and computers. Generate the pair
# once with:
#   npx web-push generate-vapid-keys
# Keep the private key secret and do not change the pair later: devices that
# turned notifications on would have to turn them on again. Leave both empty
# to run without device notifications. The subject is a contact address for
# the push services (Apple, Google, Mozilla, Microsoft).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Recurring tasks: the scheduler that calls /api/cron/recurring every minute
# must send this value (Vercel Cron sends it as a Bearer token; an external
# service can send it as the x-cron-secret header). Generate it like
# AUTH_SECRET. Without it the route stays closed and nothing recurs.
CRON_SECRET=

# Optional: the public address of the app (https://injaz.example.com). Only
# needed when the host does not forward the real domain; the Claude connector
# (MCP) uses it for its sign-in addresses and for links in answers.
# APP_URL=

# Optional: the team's time zone for "today", due dates and times shown.
# NEXT_PUBLIC_APP_TIMEZONE=Asia/Riyadh

# Optional: used by `npm run db:seed` (empty database only) for the first
# admin account. Leave the password empty to get a random one printed once.
SEED_ADMIN_NAME=Demo Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
